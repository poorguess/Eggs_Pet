; HatchPanel / HatchingPanel 用普通 Panel 而非 PanelContainer：
; Container 在自身不可见时不排序子节点（实测子节点停在 0x0），而这两块面板初始隐藏，
; 靠容器会让「破壳」状态首次出现时错位一帧。普通 Control 的 anchors/offsets 与可见性无关。
[node name="HatchPanel" type="Panel" parent="SafeArea/Layout"]
layout_mode = 1
anchor_left = 0.5
anchor_top = 1.0
anchor_right = 0.5
anchor_bottom = 1.0
offset_left = -240.0
offset_top = -300.0
offset_right = 240.0
offset_bottom = -40.0
grow_horizontal = 2
grow_vertical = 0
mouse_filter = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_solid_panel")

