[gd_scene load_steps=15 format=3]

[ext_resource type="Script" path="res://scripts/detail_panel.gd" id="1_detail"]
[ext_resource type="Theme" path="res://ui/theme.tres" id="2_theme"]

; 颜色字面值全部对应 scripts/ui_theme.gd 的常量（.tscn 是静态数据，无法引用 GDScript 常量）。
; 面板内坐标全部相对 Panel(860x680)，与原 _draw_detail_egg / _draw_detail_pet 的基线逐条对齐。
;
; 这里刻意不用任何 Container：Panel 用普通 Panel，状态行用普通 Control + 显式偏移。
; 原因：Godot 的 Container 在「自身不可见」时不排序子节点（实测 PanelContainer 的子节点会停在 0x0），
; 而 EggView/PetView 初始隐藏，靠容器会让首次显示错位一帧。普通 Control 的 anchors/offsets 与可见性无关。

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_panel"]
bg_color = Color(1, 0.976471, 0.937255, 1) ; CREAM
shadow_color = Color(0.356863, 0.290196, 0.247059, 0.18) ; SHADOW_WARM
shadow_offset = Vector2(0, 6) ; 原 draw_panel 的暖色软投影 y+6
corner_radius_top_left = 32 ; RADIUS_PANEL
corner_radius_top_right = 32
corner_radius_bottom_right = 32
corner_radius_bottom_left = 32

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_frosting"]
bg_color = Color(1, 0.419608, 0.541176, 1) ; CANDY_PINK
corner_radius_top_left = 32 ; 只圆上沿，对应 draw_frosting
corner_radius_top_right = 32

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_dot_temperature"]
bg_color = Color(1, 0.623529, 0.262745, 1) ; STATUS_TEMPERATURE #FF9F43
corner_radius_top_left = 14 ; 28x28 圆
corner_radius_top_right = 14
corner_radius_bottom_right = 14
corner_radius_bottom_left = 14

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_dot_hunger"]
bg_color = Color(1, 0.419608, 0.541176, 1) ; STATUS_HUNGER #FF6B8A
corner_radius_top_left = 14
corner_radius_top_right = 14
corner_radius_bottom_right = 14
corner_radius_bottom_left = 14

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_dot_cleanliness"]
bg_color = Color(0.309804, 0.717647, 1, 1) ; STATUS_CLEANLINESS #4FB7FF
corner_radius_top_left = 14
corner_radius_top_right = 14
corner_radius_bottom_right = 14
corner_radius_bottom_left = 14

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_dot_mood"]
bg_color = Color(1, 0.823529, 0.247059, 1) ; STATUS_MOOD / LEMON #FFD23F
corner_radius_top_left = 14
corner_radius_top_right = 14
corner_radius_bottom_right = 14
corner_radius_bottom_left = 14

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_fill_temperature"]
bg_color = Color(1, 0.623529, 0.262745, 1) ; STATUS_TEMPERATURE
corner_radius_top_left = 999 ; draw_status_bar 的药丸
corner_radius_top_right = 999
corner_radius_bottom_right = 999
corner_radius_bottom_left = 999

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_fill_hunger"]
bg_color = Color(1, 0.419608, 0.541176, 1) ; STATUS_HUNGER（同时用于亲密度条，原色即 CANDY_PINK）
corner_radius_top_left = 999
corner_radius_top_right = 999
corner_radius_bottom_right = 999
corner_radius_bottom_left = 999

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_fill_cleanliness"]
bg_color = Color(0.309804, 0.717647, 1, 1) ; STATUS_CLEANLINESS
corner_radius_top_left = 999
corner_radius_top_right = 999
corner_radius_bottom_right = 999
corner_radius_bottom_left = 999

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_fill_mood"]
bg_color = Color(1, 0.823529, 0.247059, 1) ; LEMON #FFD23F（同时用于孵化进度条，原色即 LEMON）
corner_radius_top_left = 999
corner_radius_top_right = 999
corner_radius_bottom_right = 999
corner_radius_bottom_left = 999

; 命中区放大到 88x88（原 56x56，低于 88 触摸下限）；expand_margin 负值把可见圆收回到 56x56。
[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_close"]
content_margin_left = 0
content_margin_top = 0
content_margin_right = 0
content_margin_bottom = 0
expand_margin_left = -16.0
expand_margin_top = -16.0
expand_margin_right = -16.0
expand_margin_bottom = -16.0
bg_color = Color(0.960784, 0.913725, 0.835294, 1) ; CREAM_DARK
corner_radius_top_left = 28 ; 56x56 圆
corner_radius_top_right = 28
corner_radius_bottom_right = 28
corner_radius_bottom_left = 28

