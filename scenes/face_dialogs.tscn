[gd_scene load_steps=9 format=3]

; 换脸弹窗。颜色字面值来自 scripts/ui_theme.gd，与 ui/theme.tres 同样的注释约定：
; CREAM #FFF9EF / CREAM_DARK #F5E9D5 / CANDY_PINK #FF6B8A。
; 随模式变化的颜色（糖霜条、error 标题、DIM 背板）由 face_dialogs.gd 在运行时按 UiTheme 覆盖。

[ext_resource type="Script" path="res://scripts/face_dialogs.gd" id="1_script"]
[ext_resource type="Theme" path="res://ui/theme.tres" id="2_theme"]
[ext_resource type="Texture2D" path="res://assets/ui/check.png" id="3_check"]
[ext_resource type="Texture2D" path="res://assets/ui/cross.png" id="4_cross"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_frosting"]
bg_color = Color(1, 0.419608, 0.541176, 1) ; CANDY_PINK
corner_radius_top_left = 32 ; RADIUS_PANEL
corner_radius_top_right = 32 ; RADIUS_PANEL

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_close"]
; 静态外观 56x56（= 原 draw_circle 半径 28），负 expand 让 88x88 的控件画出 56 的圆。
bg_color = Color(0.960784, 0.913725, 0.835294, 1) ; CREAM_DARK
corner_radius_top_left = 999
corner_radius_top_right = 999
corner_radius_bottom_right = 999
corner_radius_bottom_left = 999
expand_margin_left = -16.0
expand_margin_top = -16.0
expand_margin_right = -16.0
expand_margin_bottom = -16.0

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_photo_halo"]
bg_color = Color(0.960784, 0.913725, 0.835294, 1) ; CREAM_DARK
corner_radius_top_left = 24 ; RADIUS_CARD
corner_radius_top_right = 24 ; RADIUS_CARD
corner_radius_bottom_right = 24 ; RADIUS_CARD
corner_radius_bottom_left = 24 ; RADIUS_CARD

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_photo_frame"]
draw_center = false
border_width_left = 4
border_width_top = 4
border_width_right = 4
border_width_bottom = 4
border_color = Color(1, 0.419608, 0.541176, 1) ; CANDY_PINK
corner_radius_top_left = 12
corner_radius_top_right = 12
corner_radius_bottom_right = 12
corner_radius_bottom_left = 12

[node name="FaceDialogs" type="Control"]
visible = false
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")
script = ExtResource("1_script")

[node name="Dim" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.356863, 0.290196, 0.247059, 0.35) ; UiTheme.DIM（_ready 里再按 UiTheme 覆盖一次）

[node name="Panel" type="PanelContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -380.0
offset_top = -280.0
offset_right = 380.0
offset_bottom = 280.0
grow_horizontal = 2
grow_vertical = 2

[node name="Body" type="Control" parent="Panel"]
layout_mode = 2
mouse_filter = 2

[node name="Frosting" type="Panel" parent="Panel/Body"]
layout_mode = 1
anchors_preset = 10
anchor_right = 1.0
offset_bottom = 12.0
grow_horizontal = 2
mouse_filter = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_frosting")

[node name="CloseButton" type="Button" parent="Panel/Body"]
layout_mode = 1
offset_left = 632.0
offset_top = 12.0
offset_right = 720.0
offset_bottom = 100.0
theme_override_colors/font_color = Color(0.356863, 0.290196, 0.247059, 1) ; INK
theme_override_colors/font_hover_color = Color(0.356863, 0.290196, 0.247059, 1) ; INK
theme_override_colors/font_pressed_color = Color(0.356863, 0.290196, 0.247059, 1) ; INK
theme_override_styles/focus = SubResource("StyleBoxFlat_close")
theme_override_styles/hover = SubResource("StyleBoxFlat_close")
theme_override_styles/normal = SubResource("StyleBoxFlat_close")
theme_override_styles/pressed = SubResource("StyleBoxFlat_close")
text = "×"

