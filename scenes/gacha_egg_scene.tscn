[sub_resource type="Shader" id="Shader_gacha_flash"]
code = "shader_type canvas_item;

uniform float progress : hint_range(0.0, 1.0) = 0.0;
uniform float strength : hint_range(0.0, 1.4) = 0.0;
uniform vec2 origin = vec2(0.5, 0.66);
uniform float aspect = 0.5625;

void fragment() {
	vec2 delta = UV - origin;
	delta.x *= aspect;
	float dist = length(delta);
	float angle = atan(delta.y, delta.x);

	float birth = smoothstep(0.0, 0.28, progress);
	float core_radius = mix(0.012, 0.18, birth);
	float core = 1.0 - smoothstep(core_radius, core_radius + 0.085, dist);

	float burst_life = 1.0 - smoothstep(0.30, 0.58, progress);
	float burst = (1.0 - smoothstep(0.08, 0.42, dist)) * smoothstep(0.10, 0.32, progress) * burst_life;

	float ring_progress = smoothstep(0.22, 1.0, progress);
	float ring_radius = mix(0.05, 1.26, ring_progress);
	float ring_width = mix(0.105, 0.028, ring_progress);
	float ring = 1.0 - smoothstep(ring_width, ring_width + 0.04, abs(dist - ring_radius));
	float ring_fade = 1.0 - smoothstep(0.72, 1.0, progress);

	float rays = pow(abs(cos(angle * 4.0)), 18.0) * (1.0 - smoothstep(0.04, 0.72, dist));
	float ray_flash = rays * smoothstep(0.12, 0.34, progress) * (1.0 - smoothstep(0.34, 0.62, progress));

	float alpha = strength * (core * 0.95 * (1.0 - ring_progress * 0.65) + burst * 0.55 + ring * 0.52 * ring_fade + ray_flash * 0.38);
	alpha = clamp(alpha, 0.0, 0.92);
	COLOR = vec4(vec3(1.0), alpha);
}"

